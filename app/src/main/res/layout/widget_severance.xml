
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_card_dark">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEVERANCE ESTIMATE"
        android:textColor="#A8B3C4"
        android:textStyle="bold"
        android:textSize="10sp"/>

    <TextView
        android:id="@+id/today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2026-11-06"
        android:textColor="#A8B3C4"
        android:textSize="10sp"/>

    <TextView
        android:id="@+id/days"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="在職天數"
        android:textColor="#F0F3F8"
        android:textStyle="bold"
        android:textSize="16sp"
        android:layout_marginTop="10dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="假設今天被資遣 · 預估總額"
        android:textColor="#A8B3C4"
        android:textSize="11sp"
        android:layout_marginTop="8dp"/>

    <TextView
        android:id="@+id/total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NT$0"
        android:textColor="#D9C18A"
        android:textStyle="bold"
        android:textSize="28sp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#344052"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="資遣、預告及週會明細"
        android:textColor="#C0C9D6"
        android:textSize="11sp"/>

    <TextView
        android:id="@+id/meetings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="週會次數"
        android:textColor="#F0F3F8"
        android:textSize="12sp"
        android:layout_marginTop="10dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/minus"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:background="@drawable/widget_button_dark"
            android:text="−"
            android:textColor="#E6EBF2"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/plus"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/widget_button_dark"
            android:text="+"
            android:textColor="#D9C18A"
            android:textSize="20sp"/>
    </LinearLayout>
</LinearLayout>
