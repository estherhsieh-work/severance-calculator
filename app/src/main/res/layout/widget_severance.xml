<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/widget_card_dark">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="SEVERANCE ESTIMATE"
            android:textColor="#A8B3C4" android:textStyle="bold" android:textSize="10sp"
            android:letterSpacing="0.08"/>
        <TextView android:id="@+id/today" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="2026-11-03" android:textColor="#A8B3C4" android:textSize="10sp"/>
    </LinearLayout>

    <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="在職第 134 天" android:textColor="#F0F3F8" android:textStyle="bold" android:textSize="16sp"
        android:layout_marginTop="10dp"/>

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="假設今天被資遣 · 預估總額" android:textColor="#A8B3C4" android:textSize="11sp"
        android:layout_marginTop="8dp"/>

    <TextView android:id="@+id/total" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="NT$25,197" android:textColor="#D9C18A" android:textStyle="bold" android:textSize="28sp"
        android:layout_marginTop="1dp"/>

    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#344052" android:layout_marginTop="10dp" android:layout_marginBottom="8dp"/>

    <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="資遣、預告及週會明細" android:textColor="#C0C9D6" android:textSize="11sp"
        android:lineSpacingExtra="3dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
        <TextView android:id="@+id/meetings" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="週會次數：15" android:textColor="#F0F3F8" android:textSize="12sp"/>
        <Button android:id="@+id/minus" android:layout_width="38dp" android:layout_height="34dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:background="@drawable/widget_button_dark" android:text="−"
            android:textColor="#E6EBF2" android:textSize="17sp"/>
        <Button android:id="@+id/plus" android:layout_width="38dp" android:layout_height="34dp"
            android:minWidth="0dp" android:minHeight="0dp" android:padding="0dp"
            android:background="@drawable/widget_button_dark" android:text="+"
            android:textColor="#D9C18A" android:textSize="17sp" android:layout_marginStart="7dp"/>
    </LinearLayout>
</LinearLayout>
